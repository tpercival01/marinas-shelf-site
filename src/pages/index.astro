---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config/site";
import TrackReading from "../components/TrackReading.astro";
import RememberEveryRead from "../components/RememberEveryRead.astro";
import UnlockRoom from "../components/UnlockRoom.astro";
import ShareShelf from "../components/ShareShelf.astro";
import FinalCTA from "../components/FinalCTA.astro";
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow">A reading tracker for iPhone</p>

        <h1>{site.name}</h1>

		<p class="subtitle">{site.tagline}</p>

        <p class="intro">
          Track what you read on a bookcase that becomes more personal
          with every book, memory and milestone.
        </p>

        <div class="hero-actions">
          <span class="app-store-placeholder">
            Coming to the App Store
          </span>

          <a href="#your-books-belong-somewhere">
            Discover {site.name} ↓
          </a>
        </div>
      </div>

      <div class="hero-visual">
        <div class="phone-frame">
          <img
            src="/images/hero-image.jpeg"
            alt="Bookroom showing a personal wooden bookcase filled with books and decorations"
          />
        </div>
      </div>
    </div>
  </section>

  <section
    class="proposition"
    id="your-books-belong-somewhere"
  >
    <div class="container proposition-grid">
      <div>
        <p class="eyebrow">More than a list</p>

        <h2 class="section-title">
          Your books belong somewhere.
        </h2>
      </div>

      <div class="proposition-copy">
        <p class="lead">
          Most reading trackers turn your library into rows of data.
			{site.name} gives it a place to live.
        </p>

        <p>
          Every book you add becomes part of your own illustrated bookcase.
          Arrange your shelves, stack favourites, add decorations and shape
          a reading room that changes as your reading life does.
        </p>
      </div>
    </div>
  </section>
  <section class="customisation">
  <div class="container customisation-intro">
    <div>
      <p class="eyebrow">Make it yours</p>

      <h2 class="section-title">
        The same shelf.<br />
        A different room.
      </h2>
    </div>

    <div class="customisation-copy">
      <p class="lead">
        Your library does not have to look the same every time you open it.
      </p>

      <p>
        Change the wall, shelf and lighting to shape the atmosphere around
        your books, then fill the room with decorations that make it feel
        personal.
      </p>
    </div>
  </div>

  <div class="container comparison">
  <figure>
    <div class="shelf-preview">
      <img
        src="/images/mood-01.jpg"
        alt="Bookroom shelf in Dawn lighting"
        loading="lazy"
      />
    </div>

    <figcaption>
      <span>Dawn</span>
      <small>Soft morning light across the room.</small>
    </figcaption>
  </figure>

  <figure>
    <div class="shelf-preview">
      <img
        src="/images/mood-02.jpg"
        alt="Bookroom shelf in Noon lighting"
        loading="lazy"
      />
    </div>

    <figcaption>
      <span>Noon</span>
      <small>Bright, clear and full of detail.</small>
    </figcaption>
  </figure>

  <figure>
    <div class="shelf-preview">
      <img
        src="/images/mood-03.jpg"
        alt="Bookroom shelf in Dusk lighting"
        loading="lazy"
      />
    </div>

    <figcaption>
      <span>Dusk</span>
      <small>Warmer light as evening settles in.</small>
    </figcaption>
  </figure>

  <figure>
    <div class="shelf-preview">
      <img
        src="/images/mood-04.jpg"
        alt="Bookroom shelf in Night lighting"
        loading="lazy"
      />
    </div>

    <figcaption>
      <span>Night</span>
      <small>Candles and lamps bring the shelf to life.</small>
    </figcaption>
  </figure>
</div>

  <div class="container details-row">
    <article>
      <span>01</span>
      <h3>Choose the room</h3>
      <p>
        Change wall treatments and shelf finishes to alter the character
        behind your collection.
      </p>
    </article>

    <article>
      <span>02</span>
      <h3>Change the light</h3>
      <p>
        Shift the atmosphere from bright daytime shelves to a darker,
        warmer reading room.
      </p>
    </article>

    <article>
      <span>03</span>
      <h3>Fill the gaps</h3>
      <p>
        Add plants, lamps, keepsakes and other decorations alongside the
        books themselves.
      </p>
    </article>
  </div>
</section>
<TrackReading />
<RememberEveryRead />
<UnlockRoom />
<ShareShelf />
<FinalCTA />
</BaseLayout>

<style>
  .hero {
    background: #101713;
    color: #f5efe3;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 290px;
    gap: 90px;
    align-items: center;
    min-height: 780px;
    padding-top: 120px;
    padding-bottom: 70px;
  }

  .hero-copy {
    max-width: 650px;
  }

  .hero-eyebrow {
    color: #b79a62;
  }

  h1 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 104px;
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -5px;
  }

  .subtitle {
    margin: 24px 0 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 42px;
    line-height: 1.1;
  }

  .intro {
    max-width: 540px;
    margin: 28px 0 0;
    color: #c8c0b1;
    font-size: 17px;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
    margin-top: 34px;
  }

  .app-store-placeholder {
    display: inline-flex;
    align-items: center;
    min-height: 50px;
    padding: 0 20px;
    border: 1px solid rgba(245, 239, 227, 0.2);
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.03em;
  }

  .hero-actions a {
    color: #c8c0b1;
    font-size: 14px;
    text-decoration: none;
  }

  .hero-actions a:hover,
  .hero-actions a:focus-visible {
    color: #f5efe3;
  }

  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .phone-frame {
    width: 290px;
    padding: 7px;
    background: #090b09;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 38px;
    box-shadow: 0 36px 80px rgba(0, 0, 0, 0.4);
  }

  .phone-frame img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 32px;
  }

  .proposition {
    padding: 120px 0;
    background: #faf7ef;
  }

  .proposition-grid {
    display: grid;
    grid-template-columns: 1fr 0.8fr;
    gap: 100px;
  }

  .proposition-copy {
    padding-top: 34px;
    color: #655f54;
    font-size: 17px;
  }

  .proposition-copy p {
    margin-top: 0;
  }

  .proposition-copy p + p {
    margin-top: 24px;
  }

  .proposition-copy .lead {
    color: #211f1a;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 24px;
    line-height: 1.5;
  }

  .customisation {
  padding: 120px 0;
  background: var(--color-cream-100);
}

.customisation-intro {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(280px, 0.8fr);
  gap: 100px;
  align-items: start;
}

.customisation-copy {
  padding-top: 34px;
  color: var(--color-text-dark-muted);
  font-size: 17px;
}

.customisation-copy p {
  margin-top: 0;
}

.customisation-copy p + p {
  margin-top: 24px;
}

.customisation-copy .lead {
  color: var(--color-text-dark);
  font-family: var(--font-display);
  font-size: 24px;
  line-height: 1.5;
}

.comparison {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 24px;
  margin-top: 80px;
}

.comparison figure {
  margin: 0;
}

.shelf-preview {
  overflow: hidden;
  background: var(--color-walnut-900);
  box-shadow: 0 24px 55px rgb(43 28 22 / 14%);
}

.shelf-preview img {
  display: block;
  width: 100%;
  height: auto;
}

.comparison figcaption {
  padding-top: 16px;
}

.comparison figcaption span {
  display: block;
  font-family: var(--font-display);
  font-size: 22px;
}

.comparison figcaption small {
  display: block;
  margin-top: 5px;
  color: var(--color-text-dark-muted);
  font-size: 12px;
  line-height: 1.55;
}

.details-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 90px;
  border-top: 1px solid var(--color-cream-200);
}

.details-row article {
  padding: 34px 34px 0 0;
}

.details-row article + article {
  padding-left: 34px;
  border-left: 1px solid var(--color-cream-200);
}

.details-row article > span {
  color: var(--color-burgundy);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.14em;
}

.details-row h3 {
  margin: 18px 0 0;
  font-family: var(--font-display);
  font-size: 27px;
  font-weight: 400;
}

.details-row p {
  margin: 14px 0 0;
  color: var(--color-text-dark-muted);
}

@media (max-width: 1000px) {
  .comparison {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px 24px;
  }
}

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) 245px;
      gap: 50px;
    }

    .phone-frame {
      width: 245px;
    }

    h1 {
      font-size: 80px;
      letter-spacing: -4px;
    }

    .subtitle {
      font-size: 34px;
    }
  }

  @media (max-width: 700px) {
	.customisation {
  padding: 80px 0;
}

.customisation-intro,
.comparison,
.details-row {
  grid-template-columns: 1fr;
}

.customisation-intro {
  gap: 28px;
}

.customisation-copy {
  padding-top: 0;
}

.comparison {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 32px 14px;
  margin-top: 50px;
}

.comparison figcaption span {
  font-size: 19px;
}

.comparison figcaption small {
  font-size: 11px;
}

.details-row {
  margin-top: 65px;
}

.details-row article {
  padding: 28px 0;
  border-bottom: 1px solid var(--color-cream-200);
}

.details-row article + article {
  padding-left: 0;
  border-left: 0;
}
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 50px;
      min-height: auto;
      padding-top: 130px;
      padding-bottom: 70px;
    }

    h1 {
      font-size: clamp(64px, 20vw, 90px);
    }

    .subtitle {
      font-size: 32px;
    }

    .hero-visual {
      justify-content: center;
    }

    .phone-frame {
      width: min(290px, 78vw);
    }

    .proposition {
      padding: 80px 0;
    }

    .proposition-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .proposition-copy {
      padding-top: 0;
    }
  }
</style>