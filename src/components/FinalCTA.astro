---
import { site } from "../config/site";
---

<section class="final-cta">
  <div class="container final-inner">
    <p class="eyebrow">Coming to iPhone</p>

    <h2>
      Build a room around<br />
      the books you read.
    </h2>

    <p class="intro">
      A personal reading tracker where your library becomes somewhere
      worth returning to.
    </p>

    {
      site.appStoreUrl ? (
        <a
          class="store-button"
          href={site.appStoreUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          View on the App Store
        </a>
      ) : (
        <span class="store-button unavailable">
          Coming to the App Store
        </span>
      )
    }

    <div class="secondary-links">
      <a href="/how-it-works">How It Works</a>
      <span aria-hidden="true">·</span>
      <a href="/support">Support</a>
      <span aria-hidden="true">·</span>
      <a href="/privacy">Privacy</a>
    </div>
  </div>
</section>

<style>
  .final-cta {
    padding: clamp(100px, 12vw, 160px) 0;
    background:
      radial-gradient(
        circle at 50% 0%,
        rgb(183 154 98 / 10%),
        transparent 30rem
      ),
      var(--color-forest-950);
    color: var(--color-text-light);
    text-align: center;
  }

  .final-inner {
    max-width: 850px;
  }

  .final-cta .eyebrow {
    color: var(--color-brass);
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 7vw, 6rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .intro {
    max-width: 570px;
    margin: 2rem auto 0;
    color: var(--color-text-muted);
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    line-height: 1.55;
  }

  .store-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 54px;
    margin-top: 2.5rem;
    padding: 0 24px;
    border: 1px solid rgb(183 154 98 / 42%);
    border-radius: 8px;
    color: var(--color-text-light);
    font-size: 13px;
    font-weight: 650;
    letter-spacing: 0.035em;
    text-decoration: none;
  }

  a.store-button:hover,
  a.store-button:focus-visible {
    border-color: var(--color-brass);
    background: rgb(183 154 98 / 8%);
  }

  .store-button.unavailable {
    color: var(--color-text-muted);
  }

  .secondary-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 2rem;
    color: var(--color-text-muted);
    font-size: 12px;
  }

  .secondary-links a {
    text-decoration: none;
  }

  .secondary-links a:hover,
  .secondary-links a:focus-visible {
    color: var(--color-text-light);
  }

  @media (max-width: 700px) {
    .final-cta {
      padding: 90px 0;
    }
  }
</style>